# UntiSync Configuration File
# Copy this file to .env and fill in your credentials

# ============================================
# WEBUNTIS CREDENTIALS (Required)
# ============================================
# Your WebUntis login information

SURNAME=YourLastName
FORENAME=YourFirstName
UNTIS_USERNAME=your_webuntis_username
UNTIS_PASSWORD=your_webuntis_password
UNTIS_SCHOOL=your_school_identifier

# How to find your school identifier:
# Go to your WebUntis login page URL
# Example: https://YOUR_SCHOOL_NAME.webuntis.com
# Use YOUR_SCHOOL_NAME as the value


# ============================================
# GOOGLE CALENDAR ID (Required)
# ============================================
# Your main Google Calendar ID where busy events will be synced

CALENDAR_ID=your_calendar_id@group.calendar.google.com

# How to find your Calendar ID:
# 1. Open Google Calendar (https://calendar.google.com)
# 2. Click Settings (⚙️) > Settings
# 3. Select your calendar from the left sidebar
# 4. Scroll down to "Integrate calendar"
# 5. Copy the "Calendar ID"


# ============================================
# FREE CALENDAR ID (Optional)
# ============================================
# Separate calendar for cancelled/free events
# If not set, all events go to CALENDAR_ID

# FREE_CALENDAR_ID=your_free_calendar_id@group.calendar.google.com

# Dual-Calendar Mode Benefits:
# - Keeps your main calendar clean (only shows actual classes)
# - Cancelled/free periods in separate calendar
# - Easy to toggle visibility in Google Calendar


# ============================================
# SCHOOL LOCATION (Optional)
# ============================================
# Location text added to busy events
# Leave empty or comment out if not needed

SCHOOL_LOCATION=Example High School, City Name

# Example values:
# SCHOOL_LOCATION=Berlin International School
# SCHOOL_LOCATION=Gymnasium Beispiel, München
# SCHOOL_LOCATION=


# ============================================
# PROCESSING METHOD (Optional)
# ============================================
# How events are synced to Google Calendar
# Options: auto, threaded, batch, individual
# Default: auto (automatically chooses threaded)

PROCESSING_METHOD=auto

# Method Details:
# - auto: Automatically selects best method (recommended)
# - threaded: Parallel processing with thread safety (fast & reliable)
# - batch: Batch API requests (fast but may fail on some setups)
# - individual: Process one-by-one (slowest but most reliable)


# ============================================
# VERBOSE LOGGING (Optional)
# ============================================
# Show detailed progress and debug information
# Options: true, false
# Default: true

VERBOSE=true

# Set to false for minimal output:
# VERBOSE=false
